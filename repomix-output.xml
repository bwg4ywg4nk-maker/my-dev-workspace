        if end > start:
            _require(text[start] != ' ' and text[end - 1] != ' ', 'Line edge spaces')
        slots += 1
        _ceiling(slots, limits.max_lines_per_field, 'Field line slots')
        total_slots += 1
        _ceiling(total_slots, limits.max_total_line_slots, 'Total line slots')
        start = end + 1
