{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized evidence v1",
  "description": "Structural contract. Python validation additionally enforces identity, unique IDs, ordered ranges, integer-only encoding, Unicode validity and resource limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "evidence": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "evidence_id",
          "snapshot_id",
          "locator",
          "text",
          "qualifications"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^ev1:[0-9a-f]{64}$"
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "line_start",
                  "line_end"
                ],
                "properties": {
                  "kind": {
                    "const": "text"
                  },
                  "line_start": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "line_end": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "row_start",
                  "row_end",
                  "column_start",
                  "column_end"
                ],
                "properties": {
                  "kind": {
                    "const": "csv"
                  },
                  "row_start": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "row_end": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "column_start": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "column_end": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "pattern": "\\S"
          },
          "qualifications": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
